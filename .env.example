# PostgreSQL URL. For Neon, use its pooled URL here.
DATABASE_URL="postgresql://postgres:password@localhost:5432/findback?schema=public"

# For Neon, use its direct (non-pooled) URL for migrations.
# For local PostgreSQL, this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/findback?schema=public"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Generate a random secret with the command in README.md.
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# Fill these only when running npm run create-admin.
# Remove ADMIN_PASSWORD from this file after creating the account.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
